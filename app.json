{
  "expo": {
    "name": "Invoicing Pro",
    "slug": "invoicing-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "invoicing",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hairbasics.invoicing"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.hairbasics.invoicing"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-asset",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Invoicing Pro to select your company logo from your photo library."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "90f963aa-bf69-43c4-b08c-626532bc4162"
      }
    },
    "owner": "swethakandati"
  }
}
